# WagonEye -- new AWS account (biputri) topology.
#
#   source wagoneye.biputri.env.example
#
# Every name below already had a default baked into core/constants.py; these
# override them for THIS deployment, so pointing the pipeline at a different
# account is an env file rather than a source edit.

# ---- S3 -------------------------------------------------------------------
export WAGONEYE_S3_REGION=ap-south-1
export WAGONEYE_S3_TRIMMED_VIDEO_BUCKET=biputri-wagon-pre-processed-video
export WAGONEYE_S3_RAW_VIDEO_BUCKET=biputri-wagon-raw-video
export WAGONEYE_S3_OUTPUT_BUCKET=biputri-wagon-report
# NOTE: nothing in THIS repo reads a models bucket -- the S3 model-sync module
# was not part of this integration.  Weights are placed on the box by
# scripts/setup_ec2.sh and located with WAGONEYE_RECON_MODELS_DIR /
# WAGONEYE_FEAT_MODELS_DIR below.  Kept, commented, so the account inventory
# stays complete and it is obvious this is not yet wired.
# export WAGONEYE_MODELS_S3_BUCKET=biputri-wagon-eye-models

# WAGONEYE_S3_INPUT_BUCKET defaults to the TRIMMED bucket above, which is what
# --auto and --historical consume.  Set it only to read inputs from elsewhere.
# export WAGONEYE_S3_INPUT_BUCKET=biputri-wagon-pre-processed-video

# The four camera folders scanned inside the input bucket.  Defaults to
# CAMERA_S3_FOLDER's four values; override only if the rigs are renamed.
# export WAGONEYE_S3_INPUT_PREFIXES=camera_CCTV_HZBN_DHN_2_RIGHT_UP,...

# ---- Stage 1 counting engine + weights (see README) ------------------------
# export GLOBAL_WAGON_APP_DIR=~/global_count_ec2
# export WAGONEYE_RECON_MODELS_DIR=~/global_wagon_models
# export WAGONEYE_FEAT_MODELS_DIR=~/wagon_eye_global_integrated/models/features

# ---- Dashboard ingest: UAT ONLY --------------------------------------------
#
# BOTH feeds are pinned to UAT here.  This is the setting for the first real
# historical train, and it is ACTIVE (not commented) on purpose: the failure
# directions are not symmetric.  Forgetting to remove these lines costs a
# dashboard row on UAT.  Forgetting to ADD them sends a test train to the
# production dashboard, which cannot be undone from here.
#
# 1. Per-camera documents (delivery/dashboard_ingest.py).
#    Without this the feed posts to BOTH receivers, PROD first.  The `uat`
#    token is that module's own shorthand for its UAT endpoint -- no URL is
#    written out here, so this cannot drift from core/constants.py.
#    TO RESUME DUAL-RECEIVER POSTING: delete this line.  (Setting it to `v4`
#    is the same thing, spelled explicitly.)
export WAGONEYE_INSPECTION_INGEST_API_URLS=uat

# 2. The fused global report (delivery/global_train_webhook.py).
#    Already UAT-only by default, because the derived PROD path
#    .../cctv-receiver/inspections/ingest-global returns 404 -- the receiver has
#    only shipped the global endpoint on UAT.  Stated explicitly so the intent
#    is on the record rather than resting on a default.
#    Do NOT set this to true until the backend confirms PROD is live.
export WAGONEYE_GLOBAL_INGEST_ALL_RECEIVERS=false

# Both feeds are ON.  Set either to false for a run that must reach no
# dashboard at all (a `--historical` run without --historical-deliver already
# reaches no external endpoint, because Stage 6 returns before 6b/6c).
# export WAGONEYE_DASHBOARD_INGEST_ENABLED=true
# export WAGONEYE_GLOBAL_INGEST=true

# The `version` field selects the dashboard tab (v1 -> V1 tab), not the URL.
# export WAGONEYE_INSPECTION_VERSION=v1

# ---- Artifact transport ----------------------------------------------------
# Direct S3 only.  The Artifact Upload API is NOT part of this integration:
# delivery/artifact_uploader.py was deliberately not ported, so there is no
# `api` mode to select and WAGONEYE_ARTIFACT_UPLOAD_MODE has no reader here.
# Every artifact goes to the biputri buckets above via boto3.
