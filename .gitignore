# --- Model weights -------------------------------------------------------
# Placed manually on the target machine; see models/*/README.md for the exact
# filenames and directories each stage expects.
*.pt
*.pth
*.onnx

# --- Input / output media ------------------------------------------------
*.mp4
*.avi
*.mov
local_inputs/
batch_outputs/

# --- Reference copy of the counting engine -------------------------------
# Source material the wagon_count/ engine was adopted from, byte-for-byte.
# It carries its own .git, its own input videos and its own weights (~229 MB).
# Excluded deliberately: it must never become a nested repo or a second
# competing counter. Provenance tests skip cleanly when it is absent.
wagon_count - Copy_correct_count/

# --- Machine-specific deployment config ----------------------------------
# Written by scripts/setup_ec2.sh; holds absolute paths for ONE box.
wagoneye.env
*.env
!*.env.example

# --- Runtime logs / reports ----------------------------------------------
*.log
# core.logging_setup writes the rotating pipeline log here (WAGONEYE_LOG_DIR).
logs/
*.pdf
wagon_cache/
wagon_states/

# --- The external counting engine ----------------------------------------
# It is a SEPARATE project and must never be vendored or nested here.
global_wagon_app/
global_count_ec2/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
